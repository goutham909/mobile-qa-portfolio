# Copy to .env and adjust. Every value is optional; defaults live in config/config.py.

PLATFORM=android            # android | ios
RUN_ON=local                # local | saucelabs
APPIUM_URL=http://127.0.0.1:4723

DEVICE_NAME=Android Emulator
PLATFORM_VERSION=
UDID=

# Local: path to the .apk / .app. Sauce Labs: storage:filename=<uploaded file name>
APP_PATH=./apps/my-demo-app.apk

EXPLICIT_WAIT=15

SAUCE_USERNAME=
SAUCE_ACCESS_KEY=
SAUCE_REGION=eu-central-1
BUILD_NAME=mobile-qa-portfolio-local
